# Kopiere diese Datei zu ".env" und trage deine echten Werte ein:
#   cp .env.example .env
# Die .env wird von config.load_env() automatisch geladen und ist via
# .gitignore vor dem Commit geschuetzt. Niemals echte Zugangsdaten committen!

# --- eBay API (Pflicht fuer eBay-Suche) ---
# Application Keys aus dem eBay Developer Portal (Production):
# https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Optional: Speicherorte / Verhalten ---
# Pfad zur SQLite-Datenbank (Default: marketsearcher.db im Projektverzeichnis)
#MARKETSEARCHER_DB=marketsearcher.db

# Pfad fuer die Favoriten-JSON (Default: favorites.json)
#FAVORITES_PATH=favorites.json

# Verzeichnis fuer CSV-Exporte auf dem Server (Default: data/exports)
#EXPORT_DIR=data/exports

# Pause in Sekunden zwischen den Suchseiten waehrend des taeglichen Laufs
# (Default: 5, schuetzt vor Bot-Erkennung)
#DAILY_RUN_DELAY=5
